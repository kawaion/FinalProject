@startuml
skinparam classAttributeIconSize 0
hide empty members

package "collection" {
  class SortableList<E> {
    - {static} DEFAULT_CAPACITY: int = 8
    - objects: Object[]
    - size: int
    + SortableList()
    + size(): int
    + isEmpty(): boolean
    + add(e: E): boolean
    + add(index: int, element: E): void
    + get(index: int): E
    + set(index: int, element: E): E
    + remove(index: int): E
    + clear(): void
    + sort(c: Comparator<? super E>): void
    + customSort(strategy: SortStrategy<E>, comparator: Comparator<E>): SortableList<E>
    + stream(): Stream<E>
    + {static} toSortableList<T>(): Collector<T, ?, SortableList<T>>
    + toString(): String
    - ensureCapacity(requiredCapacity: int): boolean
    - grow(minCapacity: int): void
    - checkIndex(index: int): void
    - checkIndexAdd(index: int): void
    - spliterator(): Spliterator<E>
    - init(): void
  }
}

package "model" {
  class Book {
    - title: String
    - author: String
    - year: int
    - Book(title: String, author: String, year: int)
    + getTitle(): String
    + getAuthor(): String
    + getYear(): int
    + equals(o: Object): boolean
    + hashCode(): int
    + toString(): String
  }
  class "Book.Builder" as BookBuilder {
    - title: String
    - author: String
    - year: int
    + setTitle(title: String): Builder
    + setAuthor(author: String): Builder
    + setYear(year: int): Builder
    + build(): Book
  }
}

package "validation" {
  class BookValidator {
    + {static} validate(title: String, author: String, year: int): boolean
  }
}

Book +-- BookBuilder
BookBuilder ..> BookValidator : <<use>>
BookBuilder ..> Book : build()
SortableList ..> "sorter.SortStrategy" : <<use>>\ncustomSort()

note right of BookValidator
  Проверка:
  1564 ≤ year ≤ 2026,
  title/author не пустые
end note

@enduml






@startuml
skinparam classAttributeIconSize 0
hide empty members

interface SortStrategy<E> {
  + sort(list: SortableList<E>, comparator: Comparator<E>): SortableList<E>
}

class QuickSort<E> {
  - cmp: Comparator<E>
  - worklist: SortableList<E>
  + sort(list, comparator): SortableList<E>
  - sortRange(lo: int, hi: int): void
  - partition(lo: int, hi: int): int
  - swap(i: int, j: int): void
}

class MergeSort<E> {
  - worklist: SortableList<E>
  - cmp: Comparator<E>
  + sort(list, comparator): SortableList<E>
  - sortRange(range: ImageSubList): ImageSubList
  - merge(a: ImageSubList, b: ImageSubList): ImageSubList
}

class "MergeSort.ImageSubList" as ImageSubList {
  - offset: int
  - count: int
  - ImageSubList(from: int, to: int)
  - left(): int
  - right(): int
  - size(): int
  - get(i: int): E
  - set(i: int, v: E): void
}

class EvenFieldSort<E> {
  - sortStrategy: SortStrategy<E>
  - func: ToIntFunction<E>
  + EvenFieldSort(sortStrategy, func)
  + sort(list, comparator): SortableList<E>
  - extractEvenFieldElements(list, func): EvenSplit<E>
  - writeBackInPlace(list, indexList, workList): SortableList<E>
}

class "EvenFieldSort.EvenSplit" as EvenSplit {
  - indexList: SortableList<Integer>
  - workList: SortableList<E>
}

SortStrategy <|.. QuickSort
SortStrategy <|.. MergeSort
SortStrategy <|.. EvenFieldSort
EvenFieldSort o--> SortStrategy : делегирует
MergeSort +-- ImageSubList
EvenFieldSort +-- EvenSplit

note bottom of EvenFieldSort
  Сортирует только элементы
  с чётным значением func.
  Остальные остаются на местах.
end note

@enduml






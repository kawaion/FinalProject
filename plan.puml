@startuml
actor User
participant "Menu" as M
participant "BookCollectionFiller" as F
participant "Scanner" as S
participant "Book.Builder" as B
participant "BookValidator" as V
participant "SortableList<Book>" as L

User -> M : 1. Заполнить коллекцию
M -> User : размер и способ
M -> F : new BookCollectionFiller(size, output)

alt Вручную
  M -> F : fillFromScanner(scanner)
  loop size раз
    F -> S : nextLine()
    S --> F : title / author / year
    F -> B : setTitle/setAuthor/setYear
    B -> V : validate(...)
    V --> B : ok/fail
    B --> F : Book
    alt невалидно
      F -> User : сообщение об ошибке\nи повтор ввода
    end
  end
else Случайно
  M -> F : randomFill()
  F -> F : Stream.generate(...).limit(size)
else Из файла
  M -> F : fillFromFile(fileName)
  F -> F : Files.lines(...)\nfilter/map/parseLine
  F -> B : build()
  B -> V : validate
end

F -> L : collect(SortableList.toSortableList())
L --> F : SortableList<Book>
F --> M : SortableList<Book>
M -> User : печать коллекции
@enduml






@startuml
actor User
participant "Menu" as M
participant "SortableList" as L
participant "SortStrategy" as ST
participant "EvenFieldSort" as EFS
participant "MergeSort or QuickSort" as S

User -> M : 2. Отсортировать
M -> User : тип / метод / поле
M -> M : baseStrategy = new QuickSort or MergeSort\nstrategy = evenOnly ? new EvenFieldSort(...) : baseStrategy

M -> L : customSort(strategy, cmp)
L -> ST : sort(this, cmp)

alt Обычная сортировка
  ST -> S : sort(list, cmp)
  S -> L : get/set по индексам
  S --> ST : list
else Только чётные значения
  ST -> EFS : sort(list, cmp)
  EFS -> EFS : extractEvenFieldElements(list, func)\n(чётные year -> workList + indexList)
  EFS -> S : sort(workList, cmp)
  S --> EFS : workList
  EFS -> L : writeBackInPlace(list, indexList, workList)
  EFS --> ST : list
end

ST --> L : list
L --> M : list
M -> User : печать результата
opt сохранение
  M -> M : saveCollectionToFile()
  note right: APPEND в results.txt
end
@enduml





@startuml
actor User
participant "Menu" as M
participant "ExecutorService\n(2 потока)" as EX
participant "SortableList" as L

User -> M : 3. Подсчитать вхождения
M -> User : title, author, year

M -> EX : submit(task_1, start..mid)
M -> EX : submit(task_2, mid..end)

par worker 1
  EX -> L : get(j) для j от start до mid
  L --> EX : Book
  EX -> EX : сравнение с искомой книгой
else worker 2
  EX -> L : get(j) для j от mid до end
  L --> EX : Book
  EX -> EX : сравнение с искомой книгой
end

M -> EX : Future.get() для каждого
EX --> M : count_1, count_2
M -> User : total = count_1 + count_2
M -> EX : shutdown()
@enduml




